SHORTLIST_MODE=hosted
# Restricted API login, TLS for an external database. Never operator/worker login.
SHORTLIST_DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# HTTPS origin must match SHORTLIST_HOST at the edge.
SHORTLIST_APP_URL=
# Optional public booking destination; never append access tokens or research.
SHORTLIST_BOOKING_URL=
# Optional sign-in methods; configure Supabase first (docs/sign-in.md), then set to on.
SHORTLIST_AUTH_EMAIL_CODE=off
SHORTLIST_AUTH_GOOGLE=off
# Optional drafts before signup; apply migration 011 and set both Turnstile keys first (docs/anonymous-drafts.md).
SHORTLIST_ANONYMOUS_DRAFTS=off
SHORTLIST_ANONYMOUS_DAILY_CAP=50
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Header your edge overwrites with the visitor address (for example CF-Connecting-IP); empty uses the connection.
SHORTLIST_CLIENT_ADDRESS_HEADER=
