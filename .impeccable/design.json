  "narrative": {
    "northStar": "A clear research workspace",
    "overview": "GTM Shortlist extends Eygentic's identity into the user-authorized modern product workspace. Paper, white surfaces, warm neutral rules, restrained orange, and Schibsted Grotesk create a calm setting for observations, source passages, and independent human review. Rounded controls and research sheets replace the earlier square drafting-sheet treatment.\n\nThis document records the latest CSS cascade in `web/styles.css` and the components in `web/main.tsx`, `web/ResearchProgress.tsx`, and `web/ResearchPreview.tsx`. The modern redesign is an explicitly authorized extension of the application system; it supersedes the earlier drafting grid, square sheets, and button ledge. Eygentic's separate marketing website remains its own authority.",
    "keyCharacteristics": [
      "Warm paper behind white research surfaces with quiet borders.",
      "Orange ink identifies actions and active research states.",
      "Exact source passages remain readable beside labelled unknowns.",
      "Human review is visually distinct from model qualification."
    ],
    "rules": [
      {
        "name": "The Action Ink Rule",
        "body": "Reserve orange for something actionable or a meaningful state; paper and charcoal carry the research itself.",
        "section": "colors"
      },
      {
        "name": "The Readable Evidence Rule",
        "body": "Preserve the passage role for source text; do not shrink or capitalize quotations to fit more records.",
        "section": "typography"
      },
      {
        "name": "The Shared Rule Rule",
        "body": "Use aligned edges and thin separators to organize related research rather than detached dashboard tiles.",
        "section": "layout"
      }
    ],
    "dos": [
      "**Do** use paper, white surfaces, Schibsted Grotesk, quiet borders, and restrained orange ink for new application surfaces.",
      "**Do** keep exact passages readable and show retrieval dates and unknown publication dates.",
      "**Do** distinguish model qualification, human acceptance, and buying intent.",
      "**Do** preserve visible keyboard focus, minimum control heights, and reduced-motion behavior.",
      "**Do** verify content at phone and laptop widths, including narrow screens and enlarged text."
    ],
    "donts": [
      "**Don't** introduce a dark sci-fi world, neon glows, glass, or glossy decorative rockets.",
      "**Don't** substitute Inter or Geist for the approved Schibsted Grotesk identity.",
      "**Don't** flood labels, rules, and backgrounds with orange.",
      "**Don't** replace inspectable research with decorative KPI cards or compress company sheets into three columns.",
      "**Don't** present inferred pain, unknown ownership, buying intent, or progress as observed fact.",
      "**Don't** restore drafting backgrounds, offset button ledges, or ambient card shadows in this modern workspace."
    ]
  }
}
