SHORTLIST_DB=data/shortlist.sqlite3
# Local app binds to loopback. Hosted accounts are a separate release gate.
SHORTLIST_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPAPI_API_KEY=
# Trusted operator configuration only. OpenAI-compatible Gemma server.
GEMMA_BASE_URL=
GEMMA_API_KEY=
GEMMA_MODEL=
# Prompt size: auto uses compact prompts for Ollama models under 10B and other on-device servers,
# full prompts for hosted models. Set compact or full to override.
SHORTLIST_PROMPT_PROFILE=auto
SHORTLIST_GLOBAL_SEARCH_CAP=200

# Reuse immutable public page snapshots for this many hours; 0 disables reuse.
SHORTLIST_SOURCE_CACHE_HOURS=24

# Hosted mode: apply migrations with a separate operator credential first.
SHORTLIST_MODE=local
SHORTLIST_DATABASE_URL=
SHORTLIST_WORKER_DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SHORTLIST_APP_URL=
# Optional comma-separated additional plain HTTPS origins (for example the Render service alias).
SHORTLIST_ADDITIONAL_APP_URLS=
# Optional public HTTPS booking page; blank hides the setup-call action.
SHORTLIST_BOOKING_URL=

# Optional public Brandfetch client ID for the web server at runtime. Never use a secret API key.
SHORTLIST_BRANDFETCH_CLIENT_ID=
# Frontend-only development fallback, embedded at build time.
# Enables suggestions and logo fallback; not the paid Brand API or research providers.
VITE_BRANDFETCH_CLIENT_ID=
