SHORTLIST_DB=data/shortlist.sqlite3
# Local app binds to loopback. Hosted accounts are a separate release gate.
SHORTLIST_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPAPI_API_KEY=
# Trusted operator configuration only. OpenAI-compatible Gemma server.
GEMMA_BASE_URL=
GEMMA_API_KEY=
GEMMA_MODEL=
# Prompt size: auto uses compact prompts for Ollama models under 10B and other on-device servers,
# full prompts for hosted models. Set compact or full to override.
SHORTLIST_PROMPT_PROFILE=auto
SHORTLIST_GLOBAL_SEARCH_CAP=200

# Reuse immutable public page snapshots for this many hours; 0 disables reuse.
SHORTLIST_SOURCE_CACHE_HOURS=24

# Hosted mode: apply migrations with a separate operator credential first.
SHORTLIST_MODE=local
SHORTLIST_DATABASE_URL=
SHORTLIST_WORKER_DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SHORTLIST_APP_URL=
# Optional comma-separated additional plain HTTPS origins (for example the Render service alias).
SHORTLIST_ADDITIONAL_APP_URLS=
# Optional public HTTPS booking page; blank hides the setup-call action.
SHORTLIST_BOOKING_URL=

# Optional public Brandfetch client ID for the web server at runtime. Never use a secret API key.
SHORTLIST_BRANDFETCH_CLIENT_ID=
# Frontend-only development fallback, embedded at build time.
# Enables suggestions and logo fallback; not the paid Brand API or research providers.
VITE_BRANDFETCH_CLIENT_ID=

# Website-only research agent (Meta hackathon; see HACKATHON.md). Investigator: Meta Model API, Responses endpoint.
META_MODEL_API_KEY=
META_MODEL=muse-spark-1.3
# META_MODEL_BASE_URL=https://api.meta.ai/v1
# replay (default) resends returned output items with tool results; previous sends previous_response_id instead.
# META_RESPONSES_CONTINUATION=replay
# Responses reasoning.effort: minimal, low, medium, high, xhigh or max; "default" lets the model choose.
# Reasoning tokens count toward the output limit and are billed as output.
# META_REASONING_EFFORT=low
# Independent skeptic: Muse Spark Open on Baseten (OpenAI-compatible Chat Completions). Keep the -1026 model id.
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026
# BASETEN_JSON_MODE=on
# BASETEN_INPUT_USD_PER_M=1.25
# BASETEN_OUTPUT_USD_PER_M=4.25
# A run starts no new model calls once its estimated cost reaches this many US dollars.
AGENT_RUN_BUDGET_USD=1.00
# AGENT_CONCURRENCY=5
# off runs without the skeptic (ablation) and labels the run.
# AGENT_SKEPTIC=on

# Public agent demo (shortlist.agent.public; see docs/agent-public-demo.md). Not used by `shortlist serve`.
# AGENT_PUBLIC_URL=https://demo.example.com
# At least 32 characters; signs edit tokens and hashes visitor addresses.
# AGENT_PUBLIC_SECRET=
# AGENT_PUBLIC_MAX_COMPANIES=5
# AGENT_PUBLIC_RUNS_PER_HOUR=3
# AGENT_PUBLIC_MAX_ACTIVE=3
# AGENT_PUBLIC_DAILY_USD=10
# AGENT_PUBLIC_TURNSTILE_SITE_KEY=
# AGENT_PUBLIC_TURNSTILE_SECRET=
# on only behind a proxy that sets X-Forwarded-For (Modal does).
# AGENT_PUBLIC_TRUST_PROXY=off
# on uses the labelled synthetic providers: invented companies, no keys, no spending.
# AGENT_PUBLIC_SYNTHETIC=off
# AGENT_PUBLIC_DATA=data/agent-public
