        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "kind",
        "state",
        "created_at"
      ],
      "title": "AttemptView",
      "type": "object"
    },
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "title": "Domain",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "query": {
          "title": "Query",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "discovered_at": {
          "format": "date-time",
          "title": "Discovered At",
          "type": "string"
        },
        "excerpt": {
          "default": "",
          "maxLength": 3000,
          "title": "Excerpt",
          "type": "string"
        }
      },
      "required": [
        "domain",
        "name",
        "url",
        "query",
        "provider",
        "discovered_at",
        "excerpt"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "Criterion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "description": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Description",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "description",
        "required"
      ],
      "title": "Criterion",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "passage": {
          "maxLength": 1500,
          "minLength": 15,
          "title": "Passage",
          "type": "string"
        },
        "claim": {
          "maxLength": 1500,
          "minLength": 3,
          "title": "Claim",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "passage",
        "claim"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ExclusionObserved": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "matched",
            "cleared"
          ],
          "title": "Status",
          "type": "string"
        },
        "exclusion_id": {
          "title": "Exclusion Id",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "status",
        "exclusion_id",
        "evidence"
      ],
      "title": "ExclusionObserved",
      "type": "object"
    },
    "ExclusionUnknown": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "unknown",
          "default": "unknown",
          "title": "Status",
          "type": "string"
        },
        "exclusion_id": {
          "title": "Exclusion Id",
          "type": "string"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 3,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "status",
        "exclusion_id",
        "reason"
      ],
      "title": "ExclusionUnknown",
      "type": "object"
    },
    "Hypothesis": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 1500,
          "minLength": 5,
          "title": "Text",
          "type": "string"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Assumptions",
          "type": "array"
        }
      },
      "required": [
        "text",
        "assumptions"
      ],
      "title": "Hypothesis",
      "type": "object"
    },
    "Observed": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "supported",
            "contradicted"
          ],
          "title": "Status",
          "type": "string"
        },
        "criterion_id": {
          "title": "Criterion Id",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "status",
        "criterion_id",
        "evidence"
      ],
      "title": "Observed",
      "type": "object"
    },
    "OperatorNeedsResearch": {
      "additionalProperties": false,
      "properties": {
        "reviewer": {
          "maxLength": 100,
          "minLength": 2,
          "title": "Reviewer",
          "type": "string"
        },
        "note": {
          "maxLength": 2000,
          "minLength": 3,
          "title": "Note",
          "type": "string"
        },
        "source_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 21,
          "title": "Source Ids",
          "type": "array"
        },
        "outcome": {
          "const": "needs_research",
          "default": "needs_research",
          "title": "Outcome",
          "type": "string"
        }
      },
      "required": [
        "reviewer",
        "note",
        "source_ids",
        "outcome"
      ],
      "title": "OperatorNeedsResearch",
      "type": "object"
    },
    "OperatorReview": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "annotation": {
          "discriminator": {
            "mapping": {
              "needs_research": "#/$defs/OperatorNeedsResearch",
              "reviewed": "#/$defs/OperatorReviewed"
            },
            "propertyName": "outcome"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/OperatorReviewed"
            },
            {
              "$ref": "#/$defs/OperatorNeedsResearch"
            }
          ],
          "title": "Annotation"
        },
        "research_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Research Hash",
          "type": "string"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "annotation",
        "research_hash",
        "reviewed_at"
      ],
      "title": "OperatorReview",
      "type": "object"
    },
    "OperatorReviewed": {
      "additionalProperties": false,
      "properties": {
        "reviewer": {
          "maxLength": 100,
          "minLength": 2,
          "title": "Reviewer",
          "type": "string"
        },
        "note": {
          "maxLength": 2000,
          "minLength": 3,
          "title": "Note",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 21,
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "outcome": {
          "const": "reviewed",
          "default": "reviewed",
          "title": "Outcome",
          "type": "string"
        }
      },
      "required": [
        "reviewer",
        "note",
        "source_ids",
        "outcome"
      ],
      "title": "OperatorReviewed",
      "type": "object"
    },
    "Profile": {
      "additionalProperties": false,
      "properties": {
        "offer": {
          "maxLength": 4000,
          "minLength": 10,
          "title": "Offer",
          "type": "string"
        },
        "target": {
          "maxLength": 2000,
          "minLength": 5,
          "title": "Target",
          "type": "string"
        },
        "criteria": {
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Criteria",
          "type": "array"
        },
        "exclusions": {
          "default": [],
          "items": {
            "maxLength": 500,
            "minLength": 3,
            "type": "string"
          },
          "maxItems": 12,
          "title": "Exclusions",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "seller_url": {
          "title": "Seller Url",
          "type": "string"
        },
        "confirmed_at": {
          "format": "date-time",
          "title": "Confirmed At",
          "type": "string"
        }
      },
      "required": [
        "offer",
        "target",
        "criteria",
        "exclusions",
        "id",
        "seller_url",
        "confirmed_at"
      ],
      "title": "Profile",
      "type": "object"
    },
    "ProgressEvent": {
      "additionalProperties": false,
      "properties": {
        "phase": {
          "enum": [
            "seller",
            "confirmation",
            "discovery",
            "research",
            "review"
          ],
          "title": "Phase",
          "type": "string"
        },
        "label": {
          "maxLength": 400,
          "minLength": 3,
          "title": "Label",
          "type": "string"
        },
        "state": {
          "enum": [
            "started",
            "succeeded",
            "failed",
            "reused",
            "waiting"
          ],
          "title": "State",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "maxLength": 400,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "phase",
        "label",
        "state",
        "detail",
        "id",
        "created_at"
      ],
      "title": "ProgressEvent",
      "type": "object"
    },
    "Research": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "domain": {
          "title": "Domain",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "findings": {
          "items": {
            "discriminator": {
              "mapping": {
                "contradicted": "#/$defs/Observed",
                "supported": "#/$defs/Observed",
                "unknown": "#/$defs/Unknown"
              },
              "propertyName": "status"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/Observed"
              },
              {
                "$ref": "#/$defs/Unknown"
              }
            ]
          },
          "title": "Findings",
          "type": "array"
        },
        "exclusion_findings": {
          "default": [],
          "items": {
            "discriminator": {
              "mapping": {
                "cleared": "#/$defs/ExclusionObserved",
                "matched": "#/$defs/ExclusionObserved",
                "unknown": "#/$defs/ExclusionUnknown"
              },
              "propertyName": "status"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ExclusionObserved"
              },
              {
                "$ref": "#/$defs/ExclusionUnknown"
              }
            ]
          },
          "title": "Exclusion Findings",
          "type": "array"
        },
        "hypotheses": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Hypothesis"
          },
          "title": "Hypotheses",
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "title": "Sources",
          "type": "array"
        },
        "qualification": {
          "enum": [
            "fits",
            "needs_verification",
            "does_not_fit"
          ],
          "title": "Qualification",
          "type": "string"
        },
        "status": {
          "enum": [
            "complete",
            "partial"
          ],
          "title": "Status",
          "type": "string"
        },
        "unknowns": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unknowns",
          "type": "array"
        }
      },
      "required": [
        "id",
        "domain",
        "name",
        "profile_id",
        "findings",
        "exclusion_findings",
        "hypotheses",
        "sources",
        "qualification",
        "status",
        "unknowns"
      ],
      "title": "Research",
      "type": "object"
    },
    "Review": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": [
            "accepted",
            "rejected",
            "needs_research"
          ],
          "title": "Decision",
          "type": "string"
        },
        "reason": {
          "default": "",
          "maxLength": 2000,
          "title": "Reason",
          "type": "string"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        }
      },
      "required": [
        "decision",
        "reason",
        "reviewed_at"
      ],
      "title": "Review",
      "type": "object"
    },
    "RunCredits": {
      "properties": {
        "maximum": {
          "maximum": 3,
          "minimum": 1,
          "title": "Maximum",
          "type": "integer"
        },
        "used": {
          "maximum": 3,
          "minimum": 0,
          "title": "Used",
          "type": "integer"
        },
        "reserved": {
          "maximum": 3,
          "minimum": 0,
          "title": "Reserved",
          "type": "integer"
        },
        "returned": {
          "maximum": 3,
          "minimum": 0,
          "title": "Returned",
          "type": "integer"
        }
      },
      "required": [
        "maximum",
        "used",
        "reserved",
        "returned"
      ],
      "title": "RunCredits",
      "type": "object"
    },
    "RunProgress": {
      "additionalProperties": false,
      "properties": {
        "worker_online": {
          "title": "Worker Online",
          "type": "boolean"
        },
        "candidates": {
          "minimum": 0,
          "title": "Candidates",
          "type": "integer"
        },
        "sources": {
          "minimum": 0,
          "title": "Sources",
          "type": "integer"
        },
        "companies": {
          "minimum": 0,
          "title": "Companies",
          "type": "integer"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/ProgressEvent"
          },
          "maxItems": 100,
          "title": "Events",
          "type": "array"
        }
      },
      "required": [
        "worker_online",
        "candidates",
        "sources",
        "companies",
        "events"
      ],
      "title": "RunProgress",
      "type": "object"
    },
    "SavedRecord": {
      "properties": {
        "research": {
          "$ref": "#/$defs/Research"
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/Review"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "operator_review": {
          "anyOf": [
            {
              "$ref": "#/$defs/OperatorReview"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "credits_used": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credits Used"
        }
      },
      "required": [
        "research"
      ],
      "title": "SavedRecord",
      "type": "object"
    },
    "SearchClue": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "passage": {
          "maxLength": 3000,
          "title": "Passage",
          "type": "string"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        }
      },
      "required": [
        "label",
        "passage",
        "source_url",
        "observed_at"
      ],
      "title": "SearchClue",
      "type": "object"
    },
    "Selection": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "title": "Domain",
          "type": "string"
        },
        "position": {
          "minimum": 1,
          "title": "Position",
          "type": "integer"
        },
        "target_terms": {
          "items": {
            "type": "string"
          },
          "title": "Target Terms",
          "type": "array"
        },
        "clues": {
          "items": {
            "$ref": "#/$defs/SearchClue"
          },
          "title": "Clues",
          "type": "array"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "domain",
        "position",
        "target_terms",
        "clues",
        "explanation"
      ],
      "title": "Selection",
      "type": "object"
    },
    "SellerDraft": {
      "additionalProperties": false,
      "properties": {
        "offer": {
          "maxLength": 4000,
          "minLength": 10,
          "title": "Offer",
          "type": "string"
        },
        "target": {
          "maxLength": 2000,
          "minLength": 5,
          "title": "Target",
          "type": "string"
        },
        "criteria": {
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Criteria",
          "type": "array"
        },
        "unknowns": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "title": "Unknowns",
          "type": "array"
        }
      },
      "required": [
        "offer",
        "target",
        "criteria",
        "unknowns"
      ],
      "title": "SellerDraft",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "company_domain": {
          "title": "Company Domain",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "research_links": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "title": "Research Links",
          "type": "array"
        }
      },
      "required": [
        "id",
        "url",
        "company_domain",
        "title",
        "text",
        "content_hash",
        "retrieved_at",
        "published_at",
        "research_links"
      ],
      "title": "Source",
      "type": "object"
    },
    "Unknown": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "unknown",
          "default": "unknown",
          "title": "Status",
          "type": "string"
        },
        "criterion_id": {
          "title": "Criterion Id",
          "type": "string"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 3,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "status",
        "criterion_id",
        "reason"
      ],
      "title": "Unknown",
      "type": "object"
    }
  },
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "seller_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Seller Url"
    },
    "company_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Company Name"
    },
    "website_matches": {
      "items": {
        "$ref": "#/$defs/Candidate"
      },
      "maxItems": 3,
      "title": "Website Matches",
      "type": "array"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "awaiting_confirmation",
        "ready",
        "partial"
      ],
      "title": "Status",
      "type": "string"
    },
    "stage": {
      "title": "Stage",
      "type": "string"
    },
    "profile": {
      "anyOf": [
        {
          "$ref": "#/$defs/Profile"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "draft": {
      "anyOf": [
        {
          "$ref": "#/$defs/SellerDraft"
        },
        {
          "type": "null"
        }
      ],
