    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "attempts": {
      "items": {
        "$ref": "#/$defs/AttemptView"
      },
      "title": "Attempts",
